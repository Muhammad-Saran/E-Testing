# Copy to .env and fill in. Local dev runs on SQLite with these defaults.

DEBUG=True
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Karachi

# React dev server origin(s) for CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Registration gate: only emails on this domain may register (blank = allow any)
INSTITUTION_EMAIL_DOMAIN=cuiatd.edu.pk

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Database: SQLite (db.sqlite3) is used in all environments — no config needed.
