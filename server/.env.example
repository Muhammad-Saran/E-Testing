# Copy to .env and fill in. Local dev runs on SQLite with these defaults.

DEBUG=True
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Karachi

# React dev server origin(s) for CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Registration gate: only emails on this domain may register (blank = allow any)
INSTITUTION_EMAIL_DOMAIN=cuiatd.edu.pk

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Email: the default console backend prints emails (e.g. password-reset links)
# in the runserver terminal. To send real mail with Gmail, turn on 2-step
# verification, create an App Password (Google Account > Security > App passwords)
# and use the block below; check it with: python manage.py send_test_email you@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your.account@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=e-Testing <your.account@gmail.com>
FRONTEND_URL=http://127.0.0.1:8000
PASSWORD_RESET_TIMEOUT=3600

# Notifications (Module 9): email copies of notifications, and reminder times
# (minutes before an exam opens). Reminders are sent while users are online and
# by `python manage.py send_notifications` (schedule it every 5 minutes).
NOTIFICATION_EMAILS=True
EXAM_REMINDER_MINUTES=1440,60

# AI (Modules 3 & 6). auto = use T5 when installed (requirements-ai.txt), else rule-based.
AI_ENGINE=auto
AI_QG_MODEL=valhalla/t5-small-qa-qg-hl
AI_SIMILARITY_MODEL=sentence-transformers/sentence-t5-base
AI_QG_MODEL_BETTER=valhalla/t5-base-qa-qg-hl
# Short-answer similarity needed for full / half marks, and the band flagged for review.
SHORT_ANSWER_THRESHOLD=0.86
SHORT_ANSWER_PARTIAL_THRESHOLD=0.80
SHORT_ANSWER_REVIEW_MIN=0.78
SHORT_ANSWER_REVIEW_MAX=0.92
# Question-bank duplicate detection.
DUPLICATE_THRESHOLD=0.93
SIMILAR_THRESHOLD=0.88

# Brute-force protection: per-IP rate limits and account lockout.
THROTTLE_LOGIN=20/min
THROTTLE_REGISTER=20/hour
THROTTLE_PASSWORD_RESET=5/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Production (python manage.py serve): set DEBUG=False, your host names, and
# HTTPS=True when the site is served over HTTPS behind a reverse proxy.
# ALLOWED_HOSTS=etesting.example.edu
# CSRF_TRUSTED_ORIGINS=https://etesting.example.edu
# HTTPS=True
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Database: SQLite (db.sqlite3) is used in all environments — no config needed.
# DATABASE_PATH points it at another file (used for demos, load tests and E2E tests).
# DATABASE_PATH=C:/temp/etesting-demo.sqlite3
